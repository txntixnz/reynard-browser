@implementation ChildView
- (widget::TextInputHandler*)textHandler { return mGeckoChild && !mGeckoChild->Destroyed() ? &widget.handler : nullptr; }
- (NSRange)rangeForTextRange:(UITextRange*)range { return range ? range.range : NSMakeRange(NSNotFound, 0); }
- (BOOL)hasVietnameseBuffer { return NO; }
- (BOOL)ensureVietnameseBufferWithHandler:(widget::TextInputHandler*)handler { return NO; }
- (BOOL)shouldUseVietnameseIMEPath { return NO; }
- (BOOL)isKoreanInputMode { return NO; }
- (BOOL)handleKoreanInsertText:(NSString*)text withHandler:(widget::TextInputHandler*)handler { return NO; }
- (void)clearVietnameseBuffer {}
- (void)clearVietnameseMarkedRange {}
- (NSRange)geckoRangeForVisibleRange:(NSRange)range { return range; }
- (NSRange)geckoRangeForVietnameseBufferRange:(NSRange)range { return range; }
- (void)replaceVietnameseBufferRange:(NSRange)range withText:(NSString*)text {}
- (NSRange)vietnameseBufferDeleteBackwardRange { return NSMakeRange(NSNotFound, 0); }
- (NSRange)deleteBackwardRangeWithHandler:(widget::TextInputHandler*)handler {
  prefixQueries++;
  NSRange range = handler->selection;
  return range.length ? range : range.location ? NSMakeRange(range.location - 1, 1) : NSMakeRange(NSNotFound, 0);
}
- (void)flushVietnamesePendingDelete {}
- (void)scheduleEditSelectionUpdate { scheduled++; }
- (void)resetHandleState {}
- (void)updateEditMenu {}
- (void)resolveCaretMenuIfPending {}
// EDIT_METHODS
@end
static UITextRange *range(NSUInteger location, NSUInteger length) {
  UITextRange *value = [UITextRange new]; value.range = NSMakeRange(location, length); return value;
}
int main() {
  @autoreleasepool {
    ChildView *view = [ChildView new]; view->mGeckoChild = &view->widget;
    view->mEditable.mTextInputDelegate = [Delegate new];
    [view setSelectedTextRange:range(6, 3)];
    [view deleteBackward];
    assert([view->widget.handler.text isEqualToString:@"hello "] && view->scheduled == 1);
    [view insertText:@"teh"];
    [view replaceRange:range(6, 3) withText:@"the"];
    assert([view->widget.handler.text isEqualToString:@"hello the"] && view->scheduled == 3);
    [view deleteBackward]; [view insertText:@"e"];
    assert([view->widget.handler.text isEqualToString:@"hello the"] && view->scheduled == 5);
    [view setMarkedText:@"!" selectedRange:NSMakeRange(1, 0)];
    [view unmarkText];
    assert(view->scheduled == 7 && view->widget.handler.marked.location == NSNotFound);
    assert(delegateCalls == 0);
    assert(view->prefixQueries == 0 && view->widget.handler.backspaceEvents == 2);
    std::puts("PASS: delete/retype, replacement and composition do not synchronously reset the input delegate; edits schedule selection reconciliation");
    [view cut:nil]; [view paste:nil];
    assert(delegateCalls == 8);
    std::puts("PASS: external cut/paste still notify the input delegate");
    auto& handler = view->widget.handler;
    handler.text = [NSMutableString stringWithCapacity:20000];
    for (int i = 0; i < 20000; i++) { [handler.text appendString:@"a"]; }
    handler.selection = NSMakeRange(handler.text.length, 0);
    for (int i = 0; i < 20000; i++) { [view deleteBackward]; }
    assert(handler.text.length == 0 && view->prefixQueries == 0);
    std::puts("PASS: sustained deletion of long text does not query the document prefix");
    handler.text = [NSMutableString stringWithString:@"A👨‍👩‍👧‍👦e\u0301🇩🇪"];
    handler.selection = NSMakeRange(handler.text.length, 0);
    [view deleteBackward]; [view deleteBackward]; [view deleteBackward];
    assert([handler.text isEqualToString:@"A"]);
    handler.preventBackspace = true;
    [view deleteBackward];
    assert([handler.text isEqualToString:@"A"] && view->prefixQueries == 0);
    std::puts("PASS: normal Backspace preserves grapheme deletion and respects consumed key events in the editor double");
    handler.preventBackspace = false;
    handler.marked = NSMakeRange(0, 1);
    [view deleteBackward];
    assert(handler.text.length == 0 && view->prefixQueries == 1);
    std::puts("PASS: active marked-text composition retains the existing explicit-range path");
    int scheduledBefore = view->scheduled;
    view->widget.destroyed = true;
    [view insertText:@"lost"]; [view deleteBackward];
    assert(view->scheduled == scheduledBefore);
    std::puts("PASS: destroyed editors ignore keyboard edits");
  }
  return 0;
}
