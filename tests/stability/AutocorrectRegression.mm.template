// Production edit methods, a controlled editor, and an input-delegate recorder.
// Does not simulate Apple's prediction service or asynchronous Gecko IPC.
#import <Foundation/Foundation.h>
#include <algorithm>
#include <cassert>
#include <cstdio>

@interface UITextRange : NSObject
@property NSRange range;
@end
@implementation UITextRange
@end
@protocol UITextInputDelegate <NSObject>
- (void)textWillChange:(id)view;
- (void)textDidChange:(id)view;
- (void)selectionWillChange:(id)view;
- (void)selectionDidChange:(id)view;
@end
@protocol Credential <NSObject>
- (NSString*)autofillTextContentType;
- (void)didSelectOneTimeCode:(NSString*)text;
@end
static NSString *UITextContentTypeOneTimeCode = @"one-time-code";
static int delegateCalls;
@interface Delegate : NSObject <UITextInputDelegate>
@end
@implementation Delegate
- (void)textWillChange:(id)view { delegateCalls++; }
- (void)textDidChange:(id)view { delegateCalls++; }
- (void)selectionWillChange:(id)view { delegateCalls++; }
- (void)selectionDidChange:(id)view { delegateCalls++; }
@end
enum GeckoSelectionHandle { GeckoSelectionHandleNone, GeckoSelectionHandleStart };
enum ContentCommand { eContentCommandCut, eContentCommandPaste };
enum class Command { DeleteCharBackward };
namespace widget {
struct TextInputHandler {
  __strong NSMutableString *text = [NSMutableString stringWithString:@"hello teh"];
  NSRange selection = NSMakeRange(9, 0);
  NSRange marked = NSMakeRange(NSNotFound, 0);
  int backspaceEvents = 0;
  bool preventBackspace = false;
  bool HasMarkedText() { return marked.location != NSNotFound; }
  bool HandleCommand(Command command) {
    assert(command == Command::DeleteCharBackward);
    backspaceEvents++;
    if (preventBackspace) { return true; }
    NSRange range = selection;
    if (!range.length) {
      if (!range.location) { return true; }
      range = [text rangeOfComposedCharacterSequenceAtIndex:range.location - 1];
    }
    return ReplaceRange(range, @"");
  }
  bool SetSelectedRange(NSRange range) { selection = range; return true; }
  bool ReplaceRange(NSRange range, NSString *value) {
    [text replaceCharactersInRange:range withString:value];
    selection = NSMakeRange(range.location + value.length, 0); return true;
  }
  bool InsertText(NSString *value) { return ReplaceRange(selection, value); }
  bool SetMarkedText(NSString *value, NSRange range) {
    NSUInteger start = selection.location;
    ReplaceRange(selection, value); marked = NSMakeRange(start, value.length);
    selection = NSMakeRange(start + range.location, range.length); return true;
  }
  bool MarkedRange(NSRange& range) { range = marked; return marked.location != NSNotFound; }
  bool UnmarkText() { marked = NSMakeRange(NSNotFound, 0); return true; }
  bool HandlePhysicalDeleteBackward(BOOL buffer, BOOL korean) { return false; }
  bool RunCommand(ContentCommand command, bool) { return true; }
};
}
struct Widget {
  widget::TextInputHandler handler;
  bool destroyed = false;
  bool Destroyed() { return destroyed; }
  widget::TextInputHandler *GetTextInputHandler() { return &handler; }
};
struct Editable {
  __strong id<UITextInputDelegate> mTextInputDelegate;
  __strong id<Credential> mCredentialDelegate;
  BOOL mCaretMenuActive, mPendingCaretMenu;
  GeckoSelectionHandle mActiveSelectionHandle;
  NSRange mShadowSelectedRange, mVietnameseBufferSelection, mVietnameseBufferMarkedRange, mVietnamesePendingDeleteRange;
  __strong NSString *mKoreanComposedText;
  __strong NSString *mVietnameseBufferText;
  __strong id mSelectionDisplayInteraction;
};
